<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="HapticBridge" Width="1160" Height="850" MinWidth="850" MinHeight="620" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="15" Foreground="#FAF7FF" Background="#070611" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#C4BAD7"/>
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#904C3C65" Offset="0"/><GradientStop Color="#C0191429" Offset="1"/></LinearGradientBrush>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#FAF7FF"/><Setter Property="Background" Value="#B0090713"/><Setter Property="BorderBrush" Value="#756586"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="CaretBrush" Value="White"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#FAF7FF"/><Setter Property="Background" Value="#B0090713"/><Setter Property="BorderBrush" Value="#756586"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FAF7FF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#E9DFF8"/><Setter Property="Padding" Value="0,8"/></Style>
  <Style TargetType="Slider"><Setter Property="MinHeight" Value="40"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#CCB8FF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="5,0">
    <Border Height="5" CornerRadius="3" Background="#625474" VerticalAlignment="Center"/>
    <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" CornerRadius="3" Background="#CCB8FF" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="20" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Name="Handle" Background="#E7D9FF" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Center"><Border.Effect><DropShadowEffect Color="#05030B" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/></Border.Effect></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#CCB8FF" BlurRadius="5" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#A09D88BB" CornerRadius="4" Margin="2,4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FAF7FF"/><Setter Property="Background" Value="#251B3B"/><Setter Property="Padding" Value="14,10"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#FAF7FF"/><Setter Property="Background" Value="#342842"/><Setter Property="MinHeight" Value="44"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Foreground="#FAF7FF" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="15" Background="#44354F" Padding="14,10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Margin="14,0,0,0" Foreground="#CCB8FF"/><TextBlock Foreground="#FAF7FF" Text="{Binding SelectedItem,RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/></DockPanel></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#251B3B" CornerRadius="15" Padding="5" Margin="0,6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#CCB8FF" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#C4BAD7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Name="Nav" CornerRadius="17" Padding="20,15" Margin="0,0,0,7" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FAF7FF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Nav" Property="Background" Value="#865D4683"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#665D4683"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="#CCB8FF"/><Setter TargetName="Nav" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#FAF7FF"/><Setter Property="Background" Value="{StaticResource Glass}"/><Setter Property="Padding" Value="20,11"/><Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="Surface" CornerRadius="20" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Name="Glimmer" Opacity="0" IsHitTestVisible="False" CornerRadius="20"><Border.Background><RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="1"><GradientStop Color="#80F0DAFF" Offset="0"/><GradientStop Color="#00D1B5FF" Offset="1"/></RadialGradientBrush></Border.Background></Border></Grid></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#80CCB8FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E0CEFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#271638" Offset="0"/><GradientStop Color="#101323" Offset="0.6"/><GradientStop Color="#090712" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Ellipse Width="900" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-320,-280,0,0" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#655C3D8A"/><GradientStop Color="#005C3D8A" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="3,0,3,24">
    <Button Name="ScanButton" Content="Find devices" DockPanel.Dock="Right" Background="#765582" Margin="20,0,0,0"/>
    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Name="Summary" Text="No devices connected" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><TextBlock Name="BluetoothStatus" Text="Checking Bluetooth…" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel>
    <Button Name="HomeButton" Background="Transparent" Padding="0" HorizontalAlignment="Left" ToolTip="Controls"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="16" Background="#705396" Margin="0,0,13,0"><TextBlock Text="⌁" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="HapticBridge" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
   </DockPanel>
   <Grid Grid.Row="1">
    <TabControl Name="DeviceTabs" TabStripPlacement="Left" BorderThickness="0" Background="Transparent">
     <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border CornerRadius="27" Background="{StaticResource Glass}" Padding="9" Margin="0,0,20,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><TabPanel IsItemsHost="True"/></ScrollViewer></Border><Border Grid.Column="1" Background="#A0120E20" CornerRadius="28" Padding="6"><ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></TabControl.Template>
     <TabItem Header="Integrations">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24">
       <TextBlock Text="Integrations" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,24"/>
       <CheckBox Name="AllowApi" Content="Allow app and game controls" IsChecked="True" FontSize="17"/>
       <TextBlock Name="ApiStatus" Text="Starting local API…" Foreground="{StaticResource Muted}" Margin="0,5,0,20"/>
       <Button Name="CopyApiButton" Content="Copy connection" HorizontalAlignment="Left"/>
       <TextBlock Text="Paste the connection into your mod or integration." Foreground="{StaticResource Muted}" Margin="0,12,0,26" TextWrapping="Wrap"/>
       <Expander Header="Device tools" Margin="0,12,0,0"><WrapPanel Margin="0,12,0,12"><Button Name="SweepButton" Content="Test all speeds" Margin="0,0,12,8"/><Button Name="DisconnectAllButton" Content="Disconnect devices" Margin="0,0,12,8"/></WrapPanel></Expander>
       <Expander Name="ActivityExpander" Header="Activity" Margin="0,12,0,0"><TextBox Name="ActivityLog" IsReadOnly="True" Height="200" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" FontSize="12"/></Expander>
       <Button Name="DocsButton" Content="Help" HorizontalAlignment="Left" Margin="0,24,0,0"/>
      </StackPanel></ScrollViewer>
     </TabItem>
    </TabControl>
    <TextBlock Name="EmptyState" Visibility="Collapsed"/>
   </Grid>
   <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button Name="StopAllButton" DockPanel.Dock="Right" Content="Stop all  ·  Esc" Background="#71394F" Margin="20,0,0,0"/><TextBlock Name="Hint" Text="Find devices to get started." TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13"/></DockPanel>
  </Grid>
 </Grid>
</Window>
